rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /visitors/{visitorId} {
      allow create: if request.resource.data.keys().hasOnly(['page', 'time'])
        && request.resource.data.keys().hasAll(['page', 'time'])
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 2048
        && request.resource.data.time == request.time;
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow update, delete: if false;
    }
  }
}
